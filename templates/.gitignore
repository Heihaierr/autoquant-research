# The repository root ignores *.parquet, which is correct for research output
# and wrong for the four files below. They are the reason a clone can run
# without network access, and both upstream sources have already proven they
# can go away for hours at a time, so they are tracked deliberately.
!data/cache/prices_us.parquet
!data/cache/prices_us_raw.parquet
!data/cache/prices_cn.parquet
!data/cache/prices_cn_raw.parquet

# Per-instrument fetch cache. Exists only to resume a throttled run and is
# rebuilt by the fetch scripts.
data/cache/cn_by_instrument/

# QC output.
data/qc_findings.json
data/cache/*.qc.json

# Evaluation artifacts. Regenerated by every walk_forward run, and committing
# them invites reading a stale number as a current one.
evaluation/
